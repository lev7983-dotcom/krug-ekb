# Copy these names to the secret/environment settings of the production host.
# Never commit a real Telegram token or database password to GitHub.

KRUG_ENV=production
BOT_TOKEN=REPLACE_WITH_A_NEW_TOKEN_AFTER_REVOKING_THE_OLD_ONE
PUBLIC_URL=https://your-domain.ru/index.html
DATABASE_URL=postgresql://user:password@russian-db-host:5432/krug?sslmode=require
ADMIN_TELEGRAM_IDS=123456789

# Generate at least 32 random URL-safe characters. It must not equal BOT_TOKEN.
TELEGRAM_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_32_PLUS_CHARACTERS
TELEGRAM_INIT_MAX_AGE=3600
ALLOWED_ORIGINS=https://your-domain.ru

# Legal/operator data shown to users before consent.
PRIVACY_POLICY_VERSION=2026-08-16
TERMS_VERSION=2026-08-16
LEGAL_OPERATOR_NAME=ИП Фамилия Имя Отчество, ИНН 000000000000
LEGAL_OPERATOR_EMAIL=privacy@your-domain.ru
LEGAL_OPERATOR_ADDRESS=620000, Россия, г. Екатеринбург, адрес оператора

# Set to 1 only after the primary collection and storage of Russian users'
# personal data has actually been moved to databases located in Russia.
DATA_RESIDENCY_RF_CONFIRMED=0

# Local development only. Never enable this in production.
KRUG_ALLOW_DEV_AUTH=0
